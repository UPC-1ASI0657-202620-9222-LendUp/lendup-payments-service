SERVER_PORT=8082
DB_URL=jdbc:mysql://mysql:3306/lendup_pagos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=lendup_pagos
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=20
MYSQL_ROOT_PASSWORD=change-root-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=lendup_pagos
RABBITMQ_PASSWORD=change-me
# Puertos en tu máquina (no chocan con Reservas, Catálogo, Identidad ni Reputación)
MYSQL_HOST_PORT=3311
RABBITMQ_HOST_PORT=5675
RABBITMQ_MANAGEMENT_HOST_PORT=15675
# Proyecto Firebase común del equipo
FIREBASE_PROJECT_ID=lendup-desarrollo
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=./.secrets/firebase-service-account.json
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Identidad (lendup-identity-service, puerto 8081 en local). Sin token de servicio se reenvía el Authorization del
# usuario a GET /api/v1/estudiantes/me, que responde {"usuario":{"id":"..."}}.
IDENTITY_SERVICE_BASE_URL=http://host.docker.internal:8081
IDENTITY_SERVICE_TOKEN=
IDENTITY_FIREBASE_USER_URI_TEMPLATE=/api/v1/estudiantes/me
# Mercado Pago. simulado = sin credenciales: checkout_url abre el simulador del propio servicio (solo desarrollo).
# real = credenciales de prueba de tu aplicación en https://www.mercadopago.com.pe/developers/panel
MERCADOPAGO_MODE=simulado
MERCADOPAGO_SIMULATOR_BASE_URL=http://localhost:8082
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=change-me-webhook-secret
MERCADOPAGO_NOTIFICATION_URL=https://replace-with-public-https-url/api/v1/webhooks/mercado-pago
MERCADOPAGO_BACK_URL_SUCCESS=http://localhost:3000/payments/return?result=success
MERCADOPAGO_BACK_URL_FAILURE=http://localhost:3000/payments/return?result=failure
MERCADOPAGO_BACK_URL_PENDING=http://localhost:3000/payments/return?result=pending
MERCADOPAGO_SANDBOX_CHECKOUT=false
# Routing keys de productores que aún no publican (contratos pendientes, ver docs/events.md)
LOAN_CREATED_ROUTING_KEY=prestamos.creado.v1
LOAN_ACTIVATED_ROUTING_KEY=prestamos.activado.v1
LOAN_FINISHED_ROUTING_KEY=prestamos.finalizado.v1
EXTENSION_ACCEPTED_ROUTING_KEY=prestamos.extension-aceptada.v1
INCIDENT_RESOLVED_ROUTING_KEY=evidencias.incidencia-resuelta.v1
OUTBOX_RELAY_DELAY_MS=1000
OUTBOX_MAX_ATTEMPTS=10
PENDING_RECONCILIATION_DELAY_MS=300000
PENDING_RECONCILIATION_MIN_AGE_MS=600000
SPRINGDOC_ENABLED=false
SWAGGER_PUBLIC=false
