    {
      "name": "2. Pagos y garantías",
      "item": [
        {
          "name": "Listar medios de pago",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con MERCADO_PAGO ACTIVO', () => { pm.response.to.have.status(200); const m = pm.response.json()[0]; pm.expect(m.codigo).to.eql('MERCADO_PAGO'); pm.expect(m.estado).to.eql('ACTIVO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
