            "url": "{{rabbit_url}}/api/exchanges/%2F/lendup.domain.events/publish",
            "body": {
              "mode": "raw",
              "raw": "{{rabbit_body}}"
            },
            "description": "Publica en RabbitMQ (API de administración) un mensaje de ejemplo de contracts/events/v1/examples.json. Sirve para probar mientras el productor real no existe."
          }
