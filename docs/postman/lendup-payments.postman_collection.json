    {
      "name": "4. Webhook de Mercado Pago",
      "item": [
        {
          "name": "Webhook firmado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Calcula x-signature igual que Mercado Pago: HMAC-SHA256 de 'id:{data.id};request-id:{x-request-id};ts:{ts};'",
                  "const dataId = pm.variables.get('mp_payment_id');",
                  "const requestId = pm.variables.replaceIn('{{$guid}}');",
                  "const ts = Date.now().toString();",
                  "const manifest = 'id:' + dataId.toLowerCase() + ';request-id:' + requestId + ';ts:' + ts + ';';",
                  "const v1 = CryptoJS.HmacSHA256(manifest, pm.variables.get('webhook_secret')).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('mp_request_id', requestId);",
                  "pm.variables.set('mp_signature', 'ts=' + ts + ',v1=' + v1);",
                  "pm.variables.set('mp_notification_id', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 PROCESADA o DUPLICADA', () => { pm.response.to.have.status(201); pm.expect(['PROCESADA', 'DUPLICADA', 'IGNORADA']).to.include(pm.response.json().estado); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-signature",
                "value": "{{mp_signature}}"
              },
              {
                "key": "x-request-id",
                "value": "{{mp_request_id}}"
              }
            ],
            "url": "{{base_url}}/webhooks/mercado-pago?data.id={{mp_payment_id}}&type=payment",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": {{mp_notification_id}}, \"type\": \"payment\", \"action\": \"payment.updated\", \"live_mode\": false, \"data\": {\"id\": \"{{mp_payment_id}}\"}}"
            },
            "description": "Simula la notificación de Mercado Pago. El servicio consulta el pago real en Mercado Pago (mp_payment_id debe existir en tu cuenta de prueba) antes de cambiar estados."
          }
        },
        {
          "name": "Webhook con firma inválida (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 FIRMA_INVALIDA', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error).to.eql('FIRMA_INVALIDA'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-signature",
                "value": "ts=1,v1=deadbeef"
              },
              {
                "key": "x-request-id",
                "value": "falso"
              }
            ],
            "url": "{{base_url}}/webhooks/mercado-pago?data.id=123&type=payment",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": 1, \"type\": \"payment\", \"data\": {\"id\": \"123\"}}"
            }
          }
        }
      ]
    }
