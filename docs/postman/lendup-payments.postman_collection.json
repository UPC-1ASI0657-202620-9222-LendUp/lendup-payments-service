{
  "info": {
    "name": "LendUp Payments Service",
    "description": "Orden sugerido para probar sin llaves de Mercado Pago: 0b (token, usuario, cola espía) → 1 (ReservaConfirmada y PrestamoCreado) → 2 (garantía o tarifa) → 3 (aprobar en el simulador) → 0b 'Ver eventos en la cola espía'. Si un evento simulado responde routed=false, ningún servicio está escuchando en ese broker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082/api/v1"
    },
    {
      "key": "firebase_token",
      "value": "PEGAR_ID_TOKEN_DE_FIREBASE"
    },
    {
      "key": "prestatario_usuario_id",
      "value": "66666666-6666-4666-8666-666666666666"
    },
    {
      "key": "prestamista_usuario_id",
      "value": "55555555-5555-4555-8555-555555555555"
    },
    {
      "key": "reserva_id",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "prestamo_id",
      "value": "c3333333-3333-4333-8333-333333333333"
    },
    {
      "key": "cambio_fecha_prestamo_id",
      "value": "88888888-8888-4888-8888-888888888888"
    },
    {
      "key": "incidencia_id",
      "value": "99999999-9999-4999-8999-999999999999"
    },
    {
      "key": "transaccion_id",
      "value": ""
    },
    {
      "key": "checkout_url",
      "value": ""
    },
    {
      "key": "mp_payment_id",
      "value": "PEGAR_ID_DEL_PAGO_EN_MERCADO_PAGO"
    },
    {
      "key": "webhook_secret",
      "value": "MISMO_VALOR_QUE_MERCADOPAGO_WEBHOOK_SECRET"
    },
    {
      "key": "rabbit_url",
      "value": "http://localhost:15675"
    },
    {
      "key": "rabbit_user",
      "value": "lendup_pagos"
    },
    {
      "key": "rabbit_pass",
      "value": "change-me"
    },
    {
      "key": "identity_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "firebase_api_key",
      "value": "PEGAR_API_KEY_WEB_DE_FIREBASE"
    },
    {
      "key": "test_email",
      "value": "PEGAR_CORREO_DE_PRUEBA"
    },
    {
      "key": "test_password",
      "value": "PEGAR_CONTRASENA_DE_PRUEBA"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8082/actuator/health/readiness"
          }
        }
      ]
    },
    {
      "name": "0b. Preparación (token, usuario y cola espía)",
      "item": [
        {
          "name": "Iniciar sesión en Firebase (obtiene firebase_token)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si ya pegaste firebase_token a mano (o no llenaste correo/contraseña), se salta este paso.",
                  "const pass = pm.variables.get('test_password') || '';",
                  "if (!pass || pass.startsWith('PEGAR')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con idToken', () => { pm.response.to.have.status(200); pm.collectionVariables.set('firebase_token', pm.response.json().idToken); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"returnSecureToken\": true\n}"
            },
            "description": "Usa el proyecto Firebase del equipo (lendup-desarrollo) con un usuario de prueba con correo verificado. firebase_api_key es la apiKey web pública (la misma de VITE_FIREBASE_API_KEY del frontend)."
          }
        },
        {
          "name": "Mi usuario en Identidad (obtiene prestatario_usuario_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con usuario.id', () => { pm.response.to.have.status(200); pm.collectionVariables.set('prestatario_usuario_id', pm.response.json().usuario.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_token}}"
              }
            ],
            "url": "{{identity_url}}/api/v1/estudiantes/me",
            "description": "Pagos resuelve tu UID de Firebase a este usuario_id. Los eventos simulados usan este id como prestatario para que tú puedas pagar."
          }
        },
        {
          "name": "Crear cola espía (ver todos los eventos en el broker)",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbit_user}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbit_pass}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbit_url}}/api/queues/%2F/debug.lendup.eventos",
            "body": {
              "mode": "raw",
              "raw": "{\"durable\": false, \"auto_delete\": false, \"arguments\": {\"x-max-length\": 1000}}"
            },
            "description": "Solo para pruebas: cola que copia todos los eventos del exchange lendup.domain.events. Sin ninguna cola suscrita, RabbitMQ no guarda los mensajes y el broker se ve vacío."
          }
        },
        {
          "name": "Enlazar cola espía a todos los eventos (#)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbit_user}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbit_pass}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbit_url}}/api/bindings/%2F/e/lendup.domain.events/q/debug.lendup.eventos",
            "body": {
              "mode": "raw",
              "raw": "{\"routing_key\": \"#\"}"
            }
          }
        },
        {
          "name": "Ver eventos en la cola espía",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const msgs = pm.response.json(); console.log(msgs.map(m => m.routing_key));",
                  "pm.test('Hay eventos en el broker', () => pm.expect(msgs.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbit_user}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbit_pass}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbit_url}}/api/queues/%2F/debug.lendup.eventos/get",
            "body": {
              "mode": "raw",
              "raw": "{\"count\": 50, \"ackmode\": \"ack_requeue_true\", \"encoding\": \"auto\"}"
            },
            "description": "Lista los últimos eventos (routing key y cuerpo) sin borrarlos. Tras pagar en el simulador debe aparecer pagos.garantia-constituida.v1 o pagos.pago-confirmado.v1."
          }
        }
      ]
    },
    {
      "name": "1. Eventos simulados (RabbitMQ)",
      "item": [
        {
          "name": "ReservaConfirmada (Reservas)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = { reserva_id: pm.variables.get('reserva_id'), solicitud_id: pm.variables.replaceIn('{{$guid}}'), publicacion_id: pm.variables.replaceIn('{{$guid}}'), prestamista_usuario_id: pm.variables.get('prestamista_usuario_id'), prestatario_usuario_id: pm.variables.get('prestatario_usuario_id'), desde: '2026-11-10T09:00:00', hasta: '2026-11-12T09:00:01', tarifa_diaria_acordada: 20.00, garantia_monetaria_acordada: 50.00, moneda_acordada: 'PEN', lugar_intercambio_acordado: 'Campus' };",
                  "const envelope = { event_id: pm.variables.replaceIn('{{$guid}}'), event_type: 'ReservaConfirmada', event_version: 1,",
                  "  aggregate_version: Date.now(), aggregate_id: pm.variables.get('reserva_id'), occurred_at: new Date().toISOString(), correlation_id: 'postman', payload };",
                  "pm.variables.set('rabbit_body', JSON.stringify({ properties: { content_type: 'application/json' }, routing_key: 'reservas.confirmada.v1', payload: JSON.stringify(envelope), payload_encoding: 'string' }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publicado y enrutado a una cola', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().routed).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbit_user}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbit_pass}}"
                }
